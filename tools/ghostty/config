# Ghostty Configuration
# Monokai Pro theme with MesloLGS Nerd Font

# Font
font-family = "MesloLGS Nerd Font"
font-size = 13

# Window
window-padding-x = 10
window-padding-y = 10
background-opacity = 0.95
window-decoration = true
macos-titlebar-style = transparent

# Scrollback / behavior
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false

# macOS: make Option behave as Alt (covers the Alt+<key> -> ESC bindings)
macos-option-as-alt = true

# Cursor
cursor-style = block
cursor-style-blink = false

# Shell — leave unset so Ghostty uses your default login shell (/bin/zsh)

# Color theme (Ghostty built-in)
theme = Monokai Pro
