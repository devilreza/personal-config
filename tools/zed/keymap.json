[
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "ctrl-p": "file_finder::Toggle",
      "ctrl-shift-p": "command_palette::Toggle",
      "ctrl-b": "project_panel::ToggleFocus",
      "ctrl-`": "terminal_panel::ToggleFocus",
      "ctrl-\\": "terminal_panel::ToggleFocus",
      "tab": "pane::ActivateNextItem",
      "shift-tab": "pane::ActivatePrevItem",
      "space b d": "pane::CloseActiveItem",
      "space b o": "pane::CloseInactiveItems",
      "g d": "editor::GoToDefinition",
      "g r": "editor::FindAllReferences",
      "space r n": "editor::Rename",
      "space a a": "assistant::ToggleFocus",
      "space g g": "terminal_panel::ToggleFocus",
      "space t t": "workspace::NewTerminal",
      "space t z": "workspace::ToggleZoom",
      "ctrl-h": ["workspace::ActivatePaneInDirection", "Left"],
      "ctrl-j": ["workspace::ActivatePaneInDirection", "Down"],
      "ctrl-k": ["workspace::ActivatePaneInDirection", "Up"],
      "ctrl-l": ["workspace::ActivatePaneInDirection", "Right"],
      "ctrl-/": "editor::ToggleComments",
      "alt-up": "editor::MoveLineUp",
      "alt-down": "editor::MoveLineDown",
      "shift-alt-up": "editor::DuplicateLineUp",
      "shift-alt-down": "editor::DuplicateLineDown"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-\\": "workspace::ToggleBottomDock",
      "ctrl-h": ["workspace::ActivatePaneInDirection", "Left"],
      "ctrl-j": ["workspace::ActivatePaneInDirection", "Down"],
      "ctrl-k": ["workspace::ActivatePaneInDirection", "Up"],
      "ctrl-l": ["workspace::ActivatePaneInDirection", "Right"]
    }
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "ctrl-/": "editor::ToggleComments",
      "alt-up": "editor::MoveLineUp",
      "alt-down": "editor::MoveLineDown",
      "<": "editor::Outdent",
      ">": "editor::Indent"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j j": "vim::NormalBefore",
      "ctrl-`": "terminal_panel::ToggleFocus"
    }
  }
]
